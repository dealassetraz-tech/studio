
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the website.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the User entity."
        },
        "username": {
          "type": "string",
          "description": "The user's username."
        },
        "email": {
          "type": "string",
          "description": "The user's email address.",
          "format": "email"
        },
        "profileId": {
          "type": "string",
          "description": "Reference to UserProfile. (Relationship: User 1:1 UserProfile)"
        }
      },
      "required": [
        "id",
        "username",
        "email",
        "profileId"
      ]
    },
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents the profile information for a user.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the UserProfile entity."
        },
        "firstName": {
          "type": "string",
          "description": "The user's first name."
        },
        "lastName": {
          "type": "string",
          "description": "The user's last name."
        },
        "bio": {
          "type": "string",
          "description": "A short biography of the user."
        },
        "website": {
          "type": "string",
          "description": "The user's website URL.",
          "format": "uri"
        }
      },
      "required": [
        "id"
      ]
    },
    "WebsiteContent": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "WebsiteContent",
      "type": "object",
      "description": "Represents the content of a webpage on the website.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the WebsiteContent entity."
        },
        "title": {
          "type": "string",
          "description": "The title of the webpage."
        },
        "content": {
          "type": "string",
          "description": "The HTML content of the webpage."
        },
        "authorId": {
          "type": "string",
          "description": "Reference to User. (Relationship: User 1:N WebsiteContent)"
        }
      },
      "required": [
        "id",
        "title",
        "content",
        "authorId"
      ]
    },
     "BuyerRequest": {
      "title": "BuyerRequest",
      "type": "object",
      "description": "Represents a buyer's request for a property.",
      "properties": {
        "buyer": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "avatar": {
              "type": "string"
            }
          }
        },
        "requirements": {
          "type": "object",
          "properties": {
            "location": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "bedrooms": {
              "type": "number"
            },
            "budget": {
              "type": "number"
            }
          }
        }
      }
    },
    "DealLog": {
        "title": "DealLog",
        "type": "object",
        "description": "Represents a log entry for a specific deal.",
        "properties": {
            "event": {
                "type": "string",
                "description": "The name of the event that occurred.",
                "enum": [
                    "Assigned to deal",
                    "Communicated with seller",
                    "Communicated with buyer",
                    "Requested closure",
                    "Uploaded closure proof"
                ]
            },
            "timestamp": {
                "type": "string",
                "format": "date-time",
                "description": "The time the event occurred."
            },
            "userId": {
                "type": "string",
                "description": "The ID of the user who performed the action."
            }
        },
        "required": ["event", "timestamp", "userId"]
    },
    "Deal": {
        "title": "Deal",
        "type": "object",
        "description": "Represents a deal between a buyer and a seller for a property, facilitated by a broker.",
        "properties": {
            "property": {
                "type": "object",
                "properties": {
                    "address": { "type": "string" },
                    "image": { "type": "string" }
                }
            },
            "seller": {
                "type": "object",
                "properties": {
                    "name": { "type": "string" },
                    "avatar": { "type": "string" }
                }
            },
            "buyer": {
                "type": "object",
                "properties": {
                    "name": { "type": "string" },
                    "avatar": { "type": "string" }
                }
            },
            "offerPrice": {
                "type": "number"
            },
            "status": {
                "type": "string",
                "enum": ["Pending", "Accepted", "Rejected", "Active", "Closed", "Cancelled", "Pending Approval"]
            },
            "commission": {
                "type": "number"
            },
            "closureProof": {
                "type": "object",
                "properties": {
                    "fileName": { "type": "string" },
                    "url": { "type": "string" }
                }
            }
        }
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/backend/entities/User"
          },
          "description": "Stores user information. The `userId` is used for path-based access control.",
          "params": [
            {
              "name": "userId",
              "description": "The unique identifier for the user."
            }
          ]
        }
      },
      {
        "path": "/users/{userId}/profiles/{profileId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": {
            "$ref": "#/backend/entities/UserProfile"
          },
          "description": "Stores user profile information. It ensures atomicity of user and profile creation as a subcollection.",
          "params": [
            {
              "name": "userId",
              "description": "The unique identifier for the user."
            },
            {
              "name": "profileId",
              "description": "The unique identifier for the user profile. Should be equal to userId."
            }
          ]
        }
      },
      {
        "path": "/website_content/{contentId}",
        "definition": {
          "entityName": "WebsiteContent",
          "schema": {
            "$ref": "#/backend/entities/WebsiteContent"
          },
          "description": "Stores website content. Includes `authorId` for authorization and listing content by a specific author.",
          "params": [
            {
              "name": "contentId",
              "description": "The unique identifier for the website content."
            }
          ]
        }
      },
       {
        "path": "/buyer_requests/{requestId}",
        "definition": {
          "entityName": "BuyerRequest",
          "schema": {
            "$ref": "#/backend/entities/BuyerRequest"
          },
          "description": "Stores buyer requests for properties.",
          "params": [
            {
              "name": "requestId",
              "description": "The unique identifier for the buyer request."
            }
          ]
        }
      },
      {
        "path": "/deals/{dealId}",
        "definition": {
            "entityName": "Deal",
            "schema": {
                "$ref": "#/backend/entities/Deal"
            },
            "description": "Stores information about a specific deal.",
            "params": [
                {
                    "name": "dealId",
                    "description": "The unique identifier for the deal."
                }
            ]
        }
      },
      {
        "path": "/deals/{dealId}/logs/{logId}",
        "definition": {
            "entityName": "DealLog",
            "schema": {
                "$ref": "#/backend/entities/DealLog"
            },
            "description": "Stores log entries for a specific deal.",
            "params": [
                {
                    "name": "dealId",
                    "description": "The unique identifier for the deal."
                },
                {
                    "name": "logId",
                    "description": "The unique identifier for the log entry."
                }
            ]
        }
      }
    ],
    "reasoning": "The Firestore structure is designed to ensure Authorization Independence, DBAC, and QAPs. User data and website content are separated into distinct collections, with clear ownership established through path-based access and explicit `authorId` fields. User profiles are stored as a subcollection of users to ensure atomicity of user and profile creation. Website content is stored with an explicit `authorId` for simplified rules. This design facilitates listing website content while securing access to user-specific data. All documents within a collection share the same security requirements, avoiding mixing data with different access needs. The structure supports integrity by enforcing ownership, timestamps (if added later), and denormalized data via the explicit `authorId`."
  }
}
