{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's profile in the system.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The user's unique ID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the user profile was created."
        },
        "isSubscribed": {
          "type": "boolean",
          "description": "Indicates if the user has an active subscription."
        },
        "plan": {
          "type": "string",
          "description": "The user's current subscription plan."
        },
        "subscriptionExpiry": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "description": "The expiration date of the user's subscription."
        }
      },
      "required": [
        "uid",
        "email",
        "createdAt"
      ]
    }
  },
  "auth": {
    "providers": [
      "email"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores public information about a user."
    }
  }
}