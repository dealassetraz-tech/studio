
/**
 * Core Philosophy: This ruleset enforces a strict user-ownership model for personal data and an
 * author-ownership model for public content. The primary goal is to securely isolate each user's
 * private information while allowing website content to be publicly readable.
 *
 * Data Structure: The data is organized into two main top-level collections:
 * 1. `/users`: Contains all private user data. Each user's documents, including their profile,
 *    are nested under their unique user ID (`/users/{userId}`).
 * 2. `/website_content`: A flat collection for all public-facing content created by users.
 *
 * Key Security Decisions:
 * - User Isolation: A user can only access documents within their own data tree (i.e., under `/users/{their_own_userId}`).
 * - No User Listing: It is not possible for any client to list all documents in the `/users` collection.
 * - Public Content: All documents in `/website_content` are publicly readable by anyone, including unauthenticated visitors.
 * - Content Ownership: Only the original author of a document in `/website_content` can modify or delete it. This is enforced via an `authorId` field.
 *
 * Denormalization for Authorization: The `/website_content` documents include a denormalized `authorId`
 * field. This allows for simple, performant, and secure write rules without needing to perform costly
 * `get()` calls to other documents to verify ownership.
 *
 * Structural Segregation: Private user data (`/users`) and public content (`/website_content`) are stored
 * in separate top-level collections. This is a secure and efficient pattern that prevents accidental
 * exposure of private data and simplifies list queries.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------------------------------------
    // Helper Functions
    // --------------------------------------------------------------------------------

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the currently authenticated user's UID matches the provided userId.
     * This is the fundamental check for document ownership.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Checks for ownership on an existing document. Used for update and delete operations
     * to ensure the target document exists before allowing the operation.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * Validates that the `id` field within a user document matches the document's ID in the path.
     * Enforces relational integrity on creation.
     */
    function hasMatchingUserIdOnCreate(userId) {
      return request.resource.data.id == userId;
    }

    /**
     * Validates that the `id` field is immutable on updates.
     * Prevents re-associating a document with a different user.
     */
    function userIdIsImmutable() {
      return request.resource.data.id == resource.data.id;
    }
    
    /**
     * Validates that the incoming `authorId` matches the authenticated user's ID.
     * Used on create to establish ownership of new content.
     */
    function isCreatingOwnContent() {
      return isSignedIn() && request.resource.data.authorId == request.auth.uid;
    }

    /**
     * Validates that the author of an existing document is the authenticated user.
     * Used for update and delete operations.
     */
    function isContentOwner() {
      return isSignedIn() && resource != null && resource.data.authorId == request.auth.uid;
    }

    /**
     * Validates that the author field is immutable on updates.
     */
    function authorIsImmutable() {
      return request.resource.data.authorId == resource.data.authorId;
    }

    // --------------------------------------------------------------------------------
    // Collection Rules
    // --------------------------------------------------------------------------------

    /**
     * @description Controls access to a user's primary document.
     * @path /users/{userId}
     * @allow A user (uid: 'user123') can (create) their own user document at `/users/user123`.
     * @deny A user (uid: 'user456') cannot (update) another user's document at `/users/user123`.
     * @principle Restricts access to a user's own data tree and prevents user enumeration.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // CRITICAL: Prevent listing all users.
      allow create: if isOwner(userId) && hasMatchingUserIdOnCreate(userId);
      allow update: if isExistingOwner(userId) && userIdIsImmutable();
      allow delete: if isExistingOwner(userId);

      /**
       * @description Controls access to a user's profile, which is a subcollection.
       * @path /users/{userId}/profiles/{profileId}
       * @allow A user (uid: 'user123') can (get) their own profile at `/users/user123/profiles/user123`.
       * @deny A user (uid: 'user123') cannot (create) a profile at `/users/user123/profiles/anotherId`. The profileId must match userId.
       * @principle Enforces a 1:1 relationship between a user and their profile by tying access to the parent user document and validating path parameters.
       */
      match /profiles/{profileId} {
        // Path validation: The profileId MUST match the parent userId to enforce the 1:1 relationship.
        allow get, list: if isOwner(userId) && profileId == userId;
        allow create: if isOwner(userId) && profileId == userId && hasMatchingUserIdOnCreate(profileId);
        allow update: if isExistingOwner(userId) && profileId == userId && userIdIsImmutable();
        allow delete: if isExistingOwner(userId) && profileId == userId;
      }
    }

    /**
     * @description Controls access to public website content. Readable by all, writable only by the author.
     * @path /website_content/{contentId}
     * @allow An anonymous user can (get) or (list) any document in this collection.
     * @deny A signed-in user cannot (update) a document where their UID does not match the `authorId`.
     * @principle Implements a "Public Read, Owner Write" pattern using a denormalized `authorId` field for efficient authorization.
     */
    match /website_content/{contentId} {
      allow get, list: if true;
      allow create: if isCreatingOwnContent();
      allow update: if isContentOwner() && authorIsImmutable();
      allow delete: if isContentOwner();
    }
     match /properties/{propertyId} {
      allow read, list: if isSignedIn();
      allow create: if isCreatingOwnContent();
      allow update: if isContentOwner() && authorIsImmutable();
      allow delete: if isContentOwner();
    }
    match /deals/{dealId} {
      allow list: if isSignedIn();
    }
  }
}
