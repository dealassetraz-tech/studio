/**
 * Core Philosophy: This ruleset enforces a strict user-ownership model supplemented by role-based access control for administrative users.
 * The primary goal is to ensure that a user's personal data is private and can only be modified by the user themselves.
 * A secondary 'roles_admin' collection provides a mechanism to grant read-only administrative privileges.
 *
 * Data Structure: The data is organized into several top-level collections:
 * 1. `/users/{userId}`: Contains the profile document for each user, keyed by their Firebase Auth UID.
 * 2. `/properties/{propertyId}`: Contains property listings.
 * 3. `/deals/{dealId}`: Contains deal information related to properties.
 * 4. `/roles_admin/{userId}`: A simple collection where the existence of a document indicates that the user is an administrator.
 *
 * Key Security Decisions:
 * - User Privacy: Listing users is explicitly disabled to protect user privacy and prevent data scraping. A user cannot discover other users in the system.
 * - Owner-Only Writes: All write operations (create, update, delete) on a user's profile, properties, and deals are strictly limited to the authenticated owner.
 * - Administrative Access: Users designated as admins gain read-only access to all user profiles, properties, and deals for support or moderation purposes.
 * - Immutable Roles: The `roles_admin` collection is locked down and cannot be modified by any client.
 * - Secure Queries: List operations are explicitly constrained to queries that filter by the user's UID, ensuring users can only query their own data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    // --------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isResourceOwner(resource) {
        return isSignedIn() && request.auth.uid == resource.data.ownerId;
    }
    
    function isDealParticipant(resource) {
        return isSignedIn() && (request.auth.uid == resource.data.sellerId || request.auth.uid == resource.data.buyerId);
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // Collection Rules
    // --------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false; // Explicitly forbid listing all users
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
    
    match /properties/{propertyId} {
        allow get: if isResourceOwner(resource) || isAdmin();
        allow list: if request.auth.uid == request.query.ownerId;
        allow create: if isOwner(request.resource.data.ownerId);
        allow update, delete: if isResourceOwner(resource);
    }
    
    match /deals/{dealId} {
        allow get: if isDealParticipant(resource) || isAdmin();
        allow list: if request.auth.uid == request.query.sellerId;
        allow create: if isOwner(request.resource.data.sellerId);
        allow update, delete: if isDealParticipant(resource);
    }

    match /roles_admin/{userId} {
      allow read, write: if false;
    }
  }
}
